# ============================================================
# StaySetu Backend Environment Variables (Supabase PostgreSQL)
# ============================================================

# Supabase Project Credentials
# Get these from your Supabase Dashboard: Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Note: If no environment variables are provided, StaySetu 
# automatically runs in ultra-fast Resilient Offline/Local mode 
# with persistent storage and realistic verified listings!
